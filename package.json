{
  "name": "fmarinoa-portfolio",
  "version": "0.1.0",
  "author": {
    "name": "Franco Mariño",
    "url": "https://github.com/fmarinoa/"
  },
  "description": "Portfolio website of Franco Mariño, a software developer specializing in web development and open-source contributions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fmarinoa/fmarinoa-portfolio/"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky || true",
    "test": "playwright test",
    "postinstall": "pnpm exec playwright install chromium",
    "commit": "sh -c 'git commit -m \"$(agy -p \"Generate a concise conventional commit message based on this diff, response only in text format, without any extra text or markdown: $(git diff --staged)\")\"'",
    "commit:all": "git add . && npm run commit",
    "pr:create": "gh pr create -t \"$(git branch --show-current)\" -b \"\""
  },
  "dependencies": {
    "@playwright/test": "1.62.0",
    "@tsconfig/node24": "24.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "dotenv": "17.4.2",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "neostandard": "0.13.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
