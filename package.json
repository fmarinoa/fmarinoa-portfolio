{
  "name": "fmarinoa-portfolio",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24"
  },
  "author": {
    "name": "Franco Mariño",
    "url": "https://github.com/fmarinoa/"
  },
  "description": "Portfolio website of Franco Mariño, a software developer specializing in web development and open-source contributions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fmarinoa/fmarinoa-portfolio/"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky || true",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "check": "astro check",
    "commit": "sh -c 'git commit -m \"$(agy -p \"Generate a concise conventional commit message based on this diff, response only in text format, without any extra text or markdown: $(git diff --staged)\")\"'",
    "commit:all": "git add . && npm run commit",
    "pr:create": "gh pr create -t \"$(git branch --show-current)\" -b \"\""
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "11.0.3",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/coverage-v8": "4.1.10",
    "astro": "7.1.4",
    "dotenv": "17.4.2",
    "pino": "10.3.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "vitest": "4.1.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "astro-eslint-parser": "3.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "neostandard": "0.13.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript-eslint": "8.65.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
