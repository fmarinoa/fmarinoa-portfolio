{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fmarinoa-portfolio",
  "compatibility_date": "2026-10-01",
  "routes": [
    {
      "pattern": "portfolio.francomarino.dev",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
