---
import { Image } from 'astro:assets'
import StatusBadge from '@/components/StatusBadge.astro'
import { getFooterInfo } from '@/lib/content'

const footerInfo = await getFooterInfo()
const socials = footerInfo.socials
---

<section
  id="top"
  class="min-h-[70vh] md:min-h-[80vh] flex flex-col justify-center gap-4 py-12"
>
  <p class="hero-line font-mono text-sm text-accent" data-typewriter>
    $ whoami
  </p>
  <h1
    class="hero-line font-display text-6xl md:text-8xl leading-[0.9] tracking-wide text-foreground"
    style="animation-delay: 120ms"
  >
    FRANCO MARIÑO
  </h1>
  <p
    class="hero-line font-mono text-lg md:text-xl text-muted"
    style="animation-delay: 220ms"
  >
    Senior Test Automation Engineer
  </p>
  <div
    class="hero-line flex items-center gap-3 flex-wrap"
    style="animation-delay: 320ms"
  >
    <StatusBadge status="running" />
    <span class="font-mono text-xs text-dim"
      >{'// disponible para nuevos proyectos'}</span
    >
  </div>
  <div
    class="hero-line flex items-center gap-3 mt-4 flex-wrap"
    style="animation-delay: 420ms"
  >
    <button
      data-cv-trigger
      class="px-5 py-2.5 rounded-terminal bg-accent text-background font-mono text-sm font-medium hover:bg-accent-hover transition-colors hover:cursor-pointer"
    >
      Descargar CV
    </button>
    <a
      href="#projects"
      class="px-5 py-2.5 rounded-terminal border border-border text-foreground font-mono text-sm hover:border-accent hover:text-accent transition-colors"
    >
      Ver proyectos →
    </a>

    <div class="flex items-center gap-2 ml-1">
      {
        Object.entries(socials).map(([key, social]) => (
          <a
            href={social.profile}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${key} profile`}
            class="social-link flex items-center justify-center w-10 h-10 rounded-terminal border border-border transition-colors hover:border-accent"
          >
            <Image
              class:list={[
                'w-5 h-5 object-contain select-none',
                key === 'github' && 'invert',
              ]}
              src={social.icon}
              alt={`${key} icon`}
              width={32}
              height={32}
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const el = document.querySelector('[data-typewriter]')
  if (el) {
    const fullText = el.textContent ?? ''
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches

    if (reduceMotion) {
      el.textContent = fullText
    } else {
      el.textContent = ''
      let i = 0
      const type = () => {
        el.textContent = fullText.slice(0, i + 1)
        i++
        if (i < fullText.length) setTimeout(type, 60)
      }
      type()
    }
  }
</script>
