---
import { Image } from 'astro:assets'
import GithubIcon from '@/assets/icons/github.svg'
import Link from '@/components/Link.astro'
import Section from '@/components/Section.astro'
import { getProjects } from '@/lib/content'
import { toKebabOrLower } from '@/helpers/stringsUtils'
import type { Project } from '@/types'

const styleLink =
  'bg-surface-raised border border-border px-2 py-1 rounded inline-flex items-center gap-1 hover:border-accent'
const projects = await getProjects()
---

<Section sectionId="projects" title="Proyectos personales">
  <div class="relative">
    <div
      id="projects-scroll"
      class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-px-4 py-4"
    >
      {
        projects.map((project: Project) => (
          <article class="project-window snap-start shrink-0 w-[300px] md:w-[420px] rounded-terminal border border-border bg-surface hover-glow transition-shadow overflow-hidden flex flex-col">
            <div class="flex items-center gap-1.5 px-3 py-2 border-b border-border bg-surface-raised">
              <span class="window-dot window-dot-fail" aria-hidden="true" />
              <span class="window-dot window-dot-warn" aria-hidden="true" />
              <span class="window-dot window-dot-pass" aria-hidden="true" />
              <span class="ml-2 font-mono text-[11px] text-dim truncate">
                {toKebabOrLower(project.title)}
              </span>
            </div>

            <div class="p-5 flex flex-col flex-1">
              <div class="aspect-video w-full mb-4 rounded overflow-hidden flex items-center justify-center bg-surface-raised">
                {project.urls.image ? (
                  <Image
                    src={project.urls.image}
                    alt={project.title}
                    width={300}
                    height={169}
                    draggable={false}
                    class="w-full h-full object-contain select-none"
                    loading="lazy"
                  />
                ) : (
                  <span class="text-dim text-sm font-mono">
                    No image available
                  </span>
                )}
              </div>

              <h3 class="text-xl font-bold text-foreground mb-2 tracking-tight">
                {project.title}
              </h3>
              <p class="text-sm text-muted mb-4 leading-relaxed">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-2 mb-4">
                {project.technologies.map(tech => (
                  <span class="tech-tag px-2 py-1 rounded-full border text-xs font-mono">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex justify-end w-full text-sm mt-auto">
                {project.urls.demo && (
                  <Link
                    href={project.urls.demo}
                    className={`${styleLink} mr-2`}
                  >
                    Demo
                  </Link>
                )}
                {project.urls.github && (
                  <Link href={project.urls.github} className={styleLink}>
                    <Image
                      src={GithubIcon}
                      alt="GitHub"
                      width={48}
                      height={48}
                      format="svg"
                      class="size-5 select-none invert"
                    />
                    Código
                  </Link>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="edge-fade-left" aria-hidden="true"></div>
    <div class="edge-fade-right" aria-hidden="true"></div>

    <button
      id="proj-prev"
      aria-label="Anterior"
      class="hidden md:flex absolute top-1/2 -translate-y-1/2 -left-4 z-30 items-center justify-center w-9 h-9 rounded-full bg-surface border border-border text-foreground hover:border-accent hover:text-accent transition-colors"
    >
      ‹
    </button>
    <button
      id="proj-next"
      aria-label="Siguiente"
      class="hidden md:flex absolute top-1/2 -translate-y-1/2 -right-4 z-30 items-center justify-center w-9 h-9 rounded-full bg-surface border border-border text-foreground hover:border-accent hover:text-accent transition-colors"
    >
      ›
    </button>
  </div>
</Section>

<style>
  #projects-scroll {
    scrollbar-color: var(--color-border-strong) var(--color-surface);
    scrollbar-width: thin;
  }

  #projects-scroll::-webkit-scrollbar {
    height: 6px;
  }

  #projects-scroll::-webkit-scrollbar-track {
    background: var(--color-surface);
  }

  #projects-scroll::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border-radius: 9999px;
  }

  #projects-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent);
  }
</style>

<script>
  const scroller = document.getElementById('projects-scroll')
  const prevBtn = document.getElementById('proj-prev')
  const nextBtn = document.getElementById('proj-next')

  if (!scroller || !prevBtn || !nextBtn) {
    throw new Error('Projects gallery elements not found')
  }

  const getCardWidth = () => {
    const firstCard = scroller.querySelector('.project-window') as HTMLElement
    return firstCard?.offsetWidth ? firstCard.offsetWidth + 24 : 0
  }

  const isAtEnd = () =>
    scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4

  const advance = () => {
    if (isAtEnd()) {
      scroller.scrollTo({ left: 0, behavior: 'smooth' })
    } else {
      scroller.scrollBy({ left: getCardWidth(), behavior: 'smooth' })
    }
  }

  const AUTO_SLIDE_INTERVAL = 4000
  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches

  let autoSlide: ReturnType<typeof setInterval> | null = null

  const stopAutoSlide = () => {
    if (autoSlide) {
      clearInterval(autoSlide)
      autoSlide = null
    }
  }

  const startAutoSlide = () => {
    if (reduceMotion) return
    stopAutoSlide()
    autoSlide = setInterval(advance, AUTO_SLIDE_INTERVAL)
  }

  const restartAutoSlide = () => {
    stopAutoSlide()
    startAutoSlide()
  }

  prevBtn.addEventListener('click', () => {
    scroller.scrollBy({ left: -getCardWidth(), behavior: 'smooth' })
    restartAutoSlide()
  })

  nextBtn.addEventListener('click', () => {
    scroller.scrollBy({ left: getCardWidth(), behavior: 'smooth' })
    restartAutoSlide()
  })

  scroller.addEventListener('mouseenter', stopAutoSlide)
  scroller.addEventListener('mouseleave', startAutoSlide)
  scroller.addEventListener('touchstart', stopAutoSlide, { passive: true })
  scroller.addEventListener('touchend', restartAutoSlide)

  startAutoSlide()
</script>
