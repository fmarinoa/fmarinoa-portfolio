---
import InfoCard from '@/components/InfoCard.astro'
import Link from '@/components/Link.astro'
import Section from '@/components/Section.astro'
import { getCareers, getCourses } from '@/lib/content'
import type { Career, Course } from '@/types'

const careers = await getCareers()
const courses = await getCourses()
const currentYear = new Date().getFullYear()
const isCareerRunning = (career: Career) =>
  !career.period.end || Number(career.period.end) >= currentYear
---

<Section sectionId="education" title="Educación">
  <div class="grid md:grid-cols-2 gap-6 mb-6">
    {
      careers.map((career: Career) => (
        <InfoCard
          title={career.title}
          logo={career.logo}
          logoAlt={career.institutionLong}
          entity={career.institutionShort}
          location={career.location}
          period={`${career.period.start} - ${career.period.end ?? 'Presente'}`}
          details={career.details}
          status={isCareerRunning(career) ? 'running' : 'passed'}
        />
      ))
    }
  </div>

  <h3
    class="text-lg font-bold mt-6 mb-2 font-mono text-sm text-dim uppercase tracking-wide"
  >
    Algunas certificaciones:
  </h3>
  <ul class="pl-2">
    {
      courses.map((course: Course) => (
        <li class="mb-2">
          <span class="font-medium">
            <Link
              className="underline underline-offset-4 cursor-pointer"
              href={course.url}
            >
              {course.name}
            </Link>
          </span>
          <br />
          <span class="text-muted">{course.institution}</span>{' '}
          <span class="text-dim">({course.year})</span>
        </li>
      ))
    }
  </ul>
</Section>
