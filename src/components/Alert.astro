---
interface Props {
  message?: string
  state?: 'success' | 'failed'
  triggerElementId?: string
  timeout?: number
}

const { message = '', state = 'success' } = Astro.props
---

<div
  id="alert"
  class={`hidden fixed top-16 right-4 px-4 py-2 rounded-terminal border shadow-md duration-300 transition-all font-mono text-sm ${state}`}
>
  {message}
</div>

<style>
  .success {
    background-color: var(--color-pass-dim);
    border-color: var(--color-pass);
    color: var(--color-pass);
  }
  .failed {
    background-color: var(--color-fail-dim);
    border-color: var(--color-fail);
    color: var(--color-fail);
  }
</style>
