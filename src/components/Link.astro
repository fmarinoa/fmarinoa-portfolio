---
interface Props {
  href: string
  className?: string
}

const { href, className } = Astro.props
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`text-accent underline-offset-4 hover:underline hover:text-accent-hover transition-colors ${className}`}
>
  <slot />
</a>
