---
import { Image } from 'astro:assets'
import Link from '@/components/Link.astro'
import { getFooterInfo } from '@/lib/content'

const footerInfo = await getFooterInfo()
const footerSocials = footerInfo.socials
const footerLinks = footerInfo.links
const year = new Date().getFullYear()
---

<footer
  class="w-full bg-surface border-t border-border text-foreground px-4 py-3 mt-6 z-50"
>
  <div
    class="max-w-5xl mx-auto px-4 flex flex-col md:flex-row items-center justify-center md:justify-between gap-4"
  >
    <div class="flex gap-4 justify-center w-full md:w-auto">
      {
        Object.entries(footerSocials).map(([key, social]) => (
          <a
            href={social.profile}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${key} profile`}
            class="social-link flex-shrink-0 rounded-terminal flex items-center justify-center transition-all duration-300"
          >
            <Image
              class:list={[
                'social-img object-contain transition-all duration-300 select-none',
                key === 'github' && 'invert',
              ]}
              src={social.icon}
              alt={`${key} icon`}
              width={32}
              height={32}
            />
          </a>
        ))
      }
    </div>

    <span
      class="w-full md:w-auto text-center md:text-right text-sm text-muted font-mono"
    >
      &copy; {year} Franco Mariño
      <br />
      Todos los derechos reservados
    </span>
  </div>

  <div
    class="w-full md:w-auto flex flex-wrap justify-center md:justify-end gap-2 text-xs pt-2 font-mono"
  >
    <span class="text-dim">{'// EOF'}</span>
    {
      Object.values(footerLinks).map(link => (
        <Link href={link.url} className="text-muted hover:text-accent">
          {link.humanText}
        </Link>
      ))
    }
  </div>
</footer>

<style>
  .social-link:hover {
    transform: scale(1.1);
  }

  .social-link:hover .social-img {
    filter: brightness(1.1);
  }
</style>
