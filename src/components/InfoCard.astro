---
import { Image } from 'astro:assets'
import Link from './Link.astro'
import StatusBadge from './StatusBadge.astro'

interface Props {
  readonly title: string
  readonly entity: string
  readonly linkEntity?: string
  readonly location: string
  readonly period: string
  readonly details: string[]
  readonly logo?: string
  readonly logoAlt?: string
  readonly status?: 'passed' | 'running'
}

const {
  title,
  entity,
  linkEntity,
  location,
  period,
  details,
  logo,
  logoAlt,
  status,
} = Astro.props
---

<article
  class="relative bg-surface p-6 rounded-terminal border border-border hover:border-accent hover-glow transition-all duration-300 flex flex-col gap-2 group"
>
  {
    status && (
      <div class="absolute top-4 right-4">
        <StatusBadge status={status} />
      </div>
    )
  }
  {
    logo ? (
      <div class="grid grid-cols-[auto_1fr] gap-4 items-center pr-20">
        <div class="flex-shrink-0">
          <Image
            src={logo}
            alt={logoAlt ?? entity}
            width={60}
            height={60}
            class="rounded w-16 h-auto select-none"
          />
        </div>
        <div>
          <h3 class="text-xl font-bold text-foreground tracking-tight group-hover:text-accent transition-colors">
            {title}
          </h3>
          <div class="text-sm text-muted font-mono">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-dim">&gt;</span>
              {linkEntity ? (
                <Link href={linkEntity}>{entity}</Link>
              ) : (
                <span class="font-semibold text-foreground">{entity}</span>
              )}
              <span class="text-dim">|</span>
              <span class="text-dim">&gt;</span> {location}
            </div>
            <p>
              <span class="text-dim">&gt;</span> {period}
            </p>
          </div>
        </div>
      </div>
    ) : (
      <div class="pr-20">
        <h3 class="text-xl font-bold text-foreground tracking-tight group-hover:text-accent transition-colors">
          {title}
        </h3>
        <div class="text-sm text-muted font-mono">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-dim">&gt;</span>
            {linkEntity ? (
              <Link href={linkEntity}>{entity}</Link>
            ) : (
              <span class="font-semibold text-foreground">{entity}</span>
            )}
            <span class="text-dim">|</span>
            <span class="text-dim">&gt;</span> {location}
          </div>
          <p>
            <span class="text-dim">&gt;</span> {period}
          </p>
        </div>
      </div>
    )
  }

  <ul class="list-disc pl-5 text-foreground/90 space-y-1 marker:text-accent">
    {details.map(item => <li class="leading-relaxed">{item}</li>)}
  </ul>
</article>
